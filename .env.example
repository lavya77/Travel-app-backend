DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

DB_NAME=smarttravel
DB_USER=smarttravel
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

JWT_SIGNING_KEY=replace-with-a-different-long-random-secret

# Optional AI itinerary planning. The API token is used only when a user opts in.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3.8-27b
GEOAPIFY_API_KEY=

SEED_TEST_USER_USERNAME=test_01
SEED_TEST_USER_EMAIL=test_01@gmail.com
SEED_TEST_USER_PASSWORD=replace-with-a-test-password

# Optional API rate limits (DRF format, e.g. 20/minute)
# THROTTLE_ANON_RATE=120/minute
# THROTTLE_USER_RATE=240/minute
# THROTTLE_AUTH_RATE=20/minute
# THROTTLE_EXTERNAL_RATE=10/minute
# Number of reverse proxies in front of Django (0 when exposed directly)
# DRF_NUM_PROXIES=1
# TIME_ZONE=Asia/Kolkata
